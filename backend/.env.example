# Skylark BI — Environment Configuration
# Copy this file to .env and fill in the values.

# --- Data Source Selection ---
# The app auto-selects: monday.com (if token set) > Excel (if paths set) > InMemory

# --- monday.com (Production) ---
# MONDAY_API_TOKEN=your_token_here
# MONDAY_DEALS_BOARD_ID=board_id_here
# MONDAY_WO_BOARD_ID=board_id_here
# MONDAY_API_URL=https://api.monday.com/v2

# --- Excel (Development) ---
# SKYLARK_DEALS_PATH=C:\path\to\Deal funnel Data.xlsx
# SKYLARK_WO_PATH=C:\path\to\Work_Order_Tracker Data.xlsx
